{
  "name": "agena",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "lint": "biome ci .",
    "docs:links": "node scripts/check-doc-links.mjs",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "boundary": "node scripts/check-boundaries.mjs",
    "bun-gate": "node scripts/check-bun-cli.mjs",
    "ci": "pnpm lint && pnpm docs:links && pnpm boundary && pnpm typecheck && pnpm test && pnpm bun-gate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "26.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
