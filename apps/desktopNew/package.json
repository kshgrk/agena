{
  "name": "@agena/desktop-new",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "app": "node scripts/app-dev.mjs",
    "app:electron": "electron .",
    "build": "vite build",
