# Copy to .env and fill in what you need. .env is gitignored — never commit it.

# ---- required for any daemon (local or cloud) -------------------------------
# Bearer token clients present to the daemon. Generate: openssl rand -hex 24
AGENA_TOKEN=
# Claude API key for the agent runtime (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ---- cloud deploy: Modal + Cloudflare R2 (README → Getting started, Option B)
# R2 S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
CF_R2_S3=
# R2 API token credentials (Object Read & Write on your bucket)
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
# Bearer token for the cloud daemon. Generate: openssl rand -hex 24
AGENA_MODAL_TOKEN=

# ---- desktop packaging (pnpm package bakes these into the build) ------------
# The daemon URL the packaged app connects to, e.g. https://<ws>--agena.modal.run
AGENA_RELEASE_URL=
